<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ElectroHub - Online Electronics Catalog</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f4f6f9;
}

/* Header */
header{
    background:#0a3d91;
    color:#fff;
    text-align:center;
    padding:20px;
}

nav{
    background:#1565c0;
    padding:15px;
}

nav ul{
    list-style:none;
    display:flex;
    justify-content:center;
    gap:30px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

/* Filters */
.filters{
    background:white;
    margin:20px;
    padding:20px;
    border-radius:10px;

    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:15px;
}

.filters input,
.filters select{
    padding:10px;
    border:1px solid #ccc;
    border-radius:5px;
}

/* Product Grid */
.container{
    padding:20px;
}

.product-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.product-card{
    background:white;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 2px 10px rgba(0,0,0,.15);
    position:relative;
}

.discount{
    position:absolute;
    top:10px;
    right:10px;
    background:red;
    color:white;
    padding:6px 12px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
}

.product-card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.product-info{
    padding:15px;
}

.product-info h3{
    color:#0a3d91;
    margin-bottom:10px;
}

.price{
    color:green;
    font-size:22px;
    font-weight:bold;
}

.old-price{
    color:gray;
    text-decoration:line-through;
    font-size:14px;
}

.btn{
    display:inline-block;
    margin-top:10px;
    text-decoration:none;
    background:#1565c0;
    color:white;
    padding:10px 15px;
    border-radius:5px;
}

/* Product Detail */
.product-detail{
    background:white;
    margin:20px;
    padding:20px;
    border-radius:10px;
}

.detail-grid{
    display:grid;
    grid-template-columns:1fr 2fr;
    gap:25px;
}

.detail-grid img{
    width:100%;
    border-radius:10px;
}

/* Specification Table */
.spec-table{
    width:100%;
    border-collapse:collapse;
    margin-top:15px;
}

.spec-table th{
    background:#1565c0;
    color:white;
    padding:10px;
}

.spec-table td{
    border:1px solid #ddd;
    padding:10px;
}

/* Comparison Table */
.comparison{
    background:white;
    margin:20px;
    padding:20px;
    border-radius:10px;
}

.comparison table{
    width:100%;
    border-collapse:collapse;
}

.comparison th{
    background:#0a3d91;
    color:white;
    padding:12px;
}

.comparison td{
    padding:12px;
    border:1px solid #ccc;
    text-align:center;
}

.comparison tr:nth-child(even){
    background:#f8f8f8;
}

footer{
    background:#0a3d91;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

@media(max-width:768px){

.filters{
    grid-template-columns:1fr;
}

.detail-grid{
    grid-template-columns:1fr;
}

nav ul{
    flex-direction:column;
    text-align:center;
}
}
</style>
</head>

<body>

<header>
<h1>ElectroHub Electronics Catalog</h1>
<p>Laptops • Smartphones • Accessories • Smart Devices</p>
</header>

<nav>
<ul>
<li><a href="#">Home</a></li>
<li><a href="#">Laptops</a></li>
<li><a href="#">Smartphones</a></li>
<li><a href="#">Accessories</a></li>
<li><a href="#">Smart Devices</a></li>
</ul>
</nav>

<!-- Filters -->

<section class="filters">
<input type="text" placeholder="Search Products">

<select>
<option>All Categories</option>
<option>Laptops</option>
<option>Smartphones</option>
<option>Accessories</option>
<option>Smart Devices</option>
</select>

<select>
<option>Brand</option>
<option>Apple</option>
<option>Dell</option>
<option>HP</option>
<option>Samsung</option>
</select>

<select>
<option>Price Range</option>
<option>Below $500</option>
<option>$500-$1000</option>
<option>Above $1000</option>
</select>
</section>

<!-- Product Cards -->

<section class="container">
<h2>Featured Products</h2>
<br>

<div class="product-grid">

<div class="product-card">
<span class="discount">20% OFF</span>
<img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=800" alt="">
<div class="product-info">
<h3>Dell XPS 15</h3>
<p>Intel Core i7, 16GB RAM, 512GB SSD</p>
<br>
<p class="price">$1199
<span class="old-price">$1499</span>
</p>
<a href="#" class="btn">View Details</a>
</div>
</div>

<div class="product-card">
<span class="discount">15% OFF</span>
<img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=800" alt="">
<div class="product-info">
<h3>Samsung Galaxy S25</h3>
<p>256GB Storage, 12GB RAM, 5G</p>
<br>
<p class="price">$899
<span class="old-price">$1049</span>
</p>
<a href="#" class="btn">View Details</a>
</div>
</div>

<div class="product-card">
<span class="discount">10% OFF</span>
<img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=800" alt="">
<div class="product-info">
<h3>Smart Watch Pro</h3>
<p>GPS, Heart Rate Monitor, AMOLED</p>
<br>
<p class="price">$199
<span class="old-price">$229</span>
</p>
<a href="#" class="btn">View Details</a>
</div>
</div>

</div>
</section>

<!-- Product Detail -->

<section class="product-detail">

<h2>Product Specifications</h2>
<br>

<div class="detail-grid">

<img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=800" alt="Laptop">

<div>

<h2>Dell XPS 15</h2>
<br>

<p>
Premium laptop designed for performance, multitasking,
professional work, gaming, and content creation.
</p>

<table class="spec-table">

<tr>
<th>Feature</th>
<th>Description</th>
</tr>

<tr>
<td>Processor</td>
<td>Intel Core i7</td>
</tr>

<tr>
<td>RAM</td>
<td>16 GB DDR5</td>
</tr>

<tr>
<td>Storage</td>
<td>512 GB SSD</td>
</tr>

<tr>
<td>Display</td>
<td>15.6 Inch 4K UHD</td>
</tr>

<tr>
<td>Graphics</td>
<td>NVIDIA RTX Series</td>
</tr>

<tr>
<td>Battery</td>
<td>12 Hours</td>
</tr>

</table>

</div>
</div>

</section>

<!-- Comparison Table -->

<section class="comparison">

<h2>Laptop Comparison</h2>
<br>

<table>

<tr>
<th>Specification</th>
<th>Dell XPS 15</th>
<th>HP Spectre x360</th>
<th>MacBook Pro</th>
</tr>

<tr>
<td>Processor</td>
<td>Intel i7</td>
<td>Intel Ultra 7</td>
<td>Apple M3</td>
</tr>

<tr>
<td>RAM</td>
<td>16GB</td>
<td>16GB</td>
<td>18GB</td>
</tr>

<tr>
<td>Storage</td>
<td>512GB SSD</td>
<td>1TB SSD</td>
<td>512GB SSD</td>
</tr>

<tr>
<td>Display</td>
<td>15.6" 4K</td>
<td>14" OLED</td>
<td>14.2" Retina</td>
</tr>

<tr>
<td>Battery</td>
<td>12 Hours</td>
<td>13 Hours</td>
<td>18 Hours</td>
</tr>

<tr>
<td>Price</td>
<td>$1199</td>
<td>$1399</td>
<td>$1599</td>
</tr>

</table>

</section>

<footer>
<h3>© 2026 ElectroHub Electronics Store</h3>
</footer>

</body>
</html>